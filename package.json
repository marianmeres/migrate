{
  "name": "@marianmeres/migrate",
  "version": "2.0.0",
  "description": "A general-purpose extensible versioning framework for managing incremental, bi-directional changes: db migrations, undo/redo, progress tracking. Semver-labeled up/down pairs with greedy up, conservative down, dry-run plans and serialized runs. Ships PostgreSQL and SQLite helpers: a lock per run, a transaction per step.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "API.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/migrate.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/migrate/issues"
  },
  "homepage": "https://github.com/marianmeres/migrate#readme",
  "keywords": [
    "migrate",
    "migration",
    "migrations",
    "db-migrations",
    "postgres",
    "postgresql",
    "sqlite",
    "versioning",
    "semver",
    "undo",
    "redo",
    "up",
    "down"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --env-file-if-exists=.env --test \"tests/**/*.test.ts\"",
    "test:watch": "node --env-file-if-exists=.env --test --watch \"tests/**/*.test.ts\"",
    "test:deno": "deno test --no-check --no-lock --config jsr.json tests/",
    "jsr:check": "deno publish --dry-run --allow-dirty --set-version \"$npm_package_version\"",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "release": "npx --yes @marianmeres/release@^2.2.0",
    "publish:jsr": "pnpm run test:deno && deno publish --set-version \"$npm_package_version\"",
    "publish:all": "pnpm publish && pnpm run publish:jsr",
    "rp": "pnpm run release -y && pnpm run publish:all",
    "rpm": "pnpm run release minor -y && pnpm run publish:all"
  },
  "dependencies": {
    "@marianmeres/item-collection": "^1.4.2",
    "@marianmeres/semver": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
